# Second Look. Copy to .env. With no keys at all the app runs fully in local mode.

PORT=3001
# Public URL of this server. PayPal return links and webhooks use it. Webhooks need a URL PayPal can reach.
PUBLIC_URL=http://localhost:3001

# Claude. Leave empty to replay the recorded Claude Sonnet runs (server/agent/recorded-runs), with the scripted stand-in where no recording matches.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Local development only: account = run Claude through your Claude Code login (no API key is read or sent).
# LLM_BACKEND=account
# scripted = the scripted stand-in only, no recordings.
# LLM_BACKEND=scripted
# replay = recorded runs only (never the API key or the account) while PayPal keys stay live: sandbox demo mode, npm run start:sandbox.
# LLM_BACKEND=replay
# Limit the sandbox to some sellers (comma list of seller keys); the others use the local stand-in.
# SANDBOX_SELLERS=mobility_direct

# Demo timers (1 = short waits for judges, 0 = real values: 70 h auto void, 15 min undo, 2 h question timeout).
DEMO_TIMERS=1
# Optional overrides in milliseconds, used only when DEMO_TIMERS=1.
# AUTO_VOID_MS=120000
# UNDO_MS=30000
# ASK_TIMEOUT_MS=180000

# Force local mode even if keys are present, scripted stand-in only (tests use this).
# FORCE_MOCK=1
# Local mode for the video: ignore PayPal and model keys but keep replaying recorded runs (npm run demo:video sets it).
# LOCAL_ONLY=1

# Sandbox only: startup stops for any other host when a seller has keys.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# sdk = APIMatic PayPal SDK for Orders and Payments calls (default). rest = the earlier REST adapter, kept as a fallback.
# PAYPAL_TRANSPORT=sdk

# One PayPal sandbox business account and REST app per seller. Each seller is its own credentials set.
# A seller without both CLIENT_ID and CLIENT_SECRET runs on the local PayPal stand-in.
# WEBHOOK_ID is the id of the webhook registered on that seller's app, pointing to
# <PUBLIC_URL>/api/webhooks/paypal/<seller key>. Without it, that seller's webhooks are rejected (fail closed).
PAYEE_POWER_COMPANY_CLIENT_ID=
PAYEE_POWER_COMPANY_CLIENT_SECRET=
PAYEE_POWER_COMPANY_WEBHOOK_ID=
PAYEE_GARDEN_SHOP_CLIENT_ID=
PAYEE_GARDEN_SHOP_CLIENT_SECRET=
PAYEE_GARDEN_SHOP_WEBHOOK_ID=
PAYEE_MOBILITY_DIRECT_CLIENT_ID=
PAYEE_MOBILITY_DIRECT_CLIENT_SECRET=
PAYEE_MOBILITY_DIRECT_WEBHOOK_ID=
PAYEE_MAPLE_LANE_CLIENT_ID=
PAYEE_MAPLE_LANE_CLIENT_SECRET=
PAYEE_MAPLE_LANE_WEBHOOK_ID=
PAYEE_LAKESIDE_TICKETS_CLIENT_ID=
PAYEE_LAKESIDE_TICKETS_CLIENT_SECRET=
PAYEE_LAKESIDE_TICKETS_WEBHOOK_ID=
